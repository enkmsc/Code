# 3D block simulation
boundary    p p p
units       metal
atom_style  atomic

# geometry
read_data   data.pos
#replicate   4 4 4

# mass
mass    1  6.941000
mass    2 30.973763
mass    3 32.064999
mass    4 79.904

group li type 1
group other type 2 3 4

# MTP potential
pair_style      mlip load_from=mlip.mtp extrapolation_control=true extrapolation_control:threshold_break=5 extrapolation_control:threshold_save=1.4 extrapolation_control:save_extrapolative_to=sampledcfgs
pair_coeff      * *

#variable
variable ke equal ke
variable pe equal pe
variable etotal equal etotal
variable step equal step
variable temp equal temp
variable vol equal vol
variable press equal press
variable fmax equal fmax

compute 1 li temp
compute 2 other temp

thermo_style custom step temp pe ke etotal vol press fnorm fmax c_1 c_2
thermo 1000

#fix 1 all box/relax aniso 0.0
minimize 1.0e-6 1.0e-6 1000000 1000000

#initial
timestep 2e-3
velocity li create 700 ${r} rot yes dist gaussian mom yes
velocity other create 700 ${r} rot yes dist gaussian mom yes

dump 3 all custom 5000 cfg id type xu yu zu
dump_modify 3 sort id

comm_modify cutoff 10

# thermalization
#reset_timestep 0
#fix 1 li nvt temp 800 800 $(100.0*dt)
fix 2 all npt temp 700 700 $(100.0*dt) x 0 0 $(1000*dt) y 0 0 $(1000*dt) z 0 0 $(1000*dt) fixedpoint 0 0 0
run 25000

