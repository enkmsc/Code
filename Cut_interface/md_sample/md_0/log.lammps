package kokkos
package kokkos newton on neigh half
# === NPT continuation from 300 K restart, now 1200 K for 10 ns ===
units           metal
atom_style      atomic
boundary        p p p
newton          on
processors      1 1 12


# === Restart from previous run ===
read_data       LCO_LLZO.data
