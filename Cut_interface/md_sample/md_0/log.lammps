include         PARM.FILE
# === pair style and kspace ===
pair_style      mliap unified MACETest_stagetwo.model-mliap_lammps.pt 0
pair_coeff      * * Li La Zr Co O

# === Neighbor settings ===
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# === Energy minimization (resolve bad contacts) ===
minimize        1.0e-6 1.0e-8 1000 10000

